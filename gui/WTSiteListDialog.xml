    <GUIProfiles>
        <Profile name="fs25_guiElement" extends="baseReference"/>
        <Profile name="wtsTitle" extends="fs25_textDefault" with="anchorTopCenter">
            <size value="820px 22px"/> <textSize value="20px"/> <textBold value="true"/> <textColor value="1 1 1 1"/> <textAlignment value="center"/>
        </Profile>
        <Profile name="wtsSubtitle" extends="fs25_textDefault" with="anchorTopCenter">
            <size value="820px 16px"/> <textSize value="12px"/> <textColor value="0.55 0.75 0.9 1"/> <textAlignment value="center"/>
        </Profile>
        <Profile name="wtsDivider" extends="baseReference" with="anchorTopCenter">
            <size value="820px 1px"/> <imageColor value="0.3 0.35 0.45 0.8"/>
        </Profile>
        <Profile name="wtsHdrBase" extends="fs25_textDefault" with="anchorTopCenter">
            <textSize value="11px"/> <textBold value="true"/> <textColor value="0.55 0.7 0.9 1"/>
        </Profile>
        <Profile name="wtsHdrName"    extends="wtsHdrBase"> <size value="200px 14px"/> <textAlignment value="left"/> </Profile>
        <Profile name="wtsHdrPurpose" extends="wtsHdrBase"> <size value="140px 14px"/> <textAlignment value="left"/> </Profile>
        <Profile name="wtsHdrState"   extends="wtsHdrBase"> <size value="150px 14px"/> <textAlignment value="left"/> </Profile>
        <Profile name="wtsRowOdd"  extends="baseReference" with="anchorTopCenter"> <size value="820px 18px"/> <imageColor value="0.08 0.09 0.12 0.6"/> </Profile>
        <Profile name="wtsRowEven" extends="baseReference" with="anchorTopCenter"> <size value="820px 18px"/> <imageColor value="0.06 0.06 0.09 0.4"/> </Profile>
        <Profile name="wtsCellBase" extends="fs25_textDefault" with="anchorTopCenter"> <textSize value="12px"/> <textColor value="0.82 0.82 0.82 1"/> </Profile>
        <Profile name="wtsCellName"  extends="wtsCellBase"> <size value="200px 16px"/> <textAlignment value="left"/> <textBold value="true"/> <textColor value="1 1 1 1"/> </Profile>
        <Profile name="wtsCellPurp"  extends="wtsCellBase"> <size value="140px 16px"/> <textAlignment value="left"/> <textColor value="0.55 0.80 1 1"/> </Profile>
        <Profile name="wtsCellState" extends="wtsCellBase"> <size value="150px 16px"/> <textAlignment value="left"/> <textColor value="0.62 0.72 0.85 1"/> </Profile>
        <Profile name="wtsBtnBg"   extends="baseReference"   with="anchorTopCenter"> <size value="44px 16px"/> <imageColor value="0.10 0.16 0.32 0.95"/> </Profile>
        <Profile name="wtsBtnText" extends="fs25_textDefault" with="anchorTopCenter"> <size value="44px 14px"/> <textSize value="10px"/> <textBold value="true"/> <textColor value="0.6 0.8 1 1"/> <textAlignment value="center"/> </Profile>
        <Profile name="wtsBtnHit"  extends="emptyPanel"       with="anchorTopCenter"> <size value="44px 16px"/> <isFocusable value="true"/> </Profile>
        <Profile name="wtsDelBg"   extends="baseReference"   with="anchorTopCenter"> <size value="44px 16px"/> <imageColor value="0.28 0.08 0.08 0.95"/> </Profile>
        <Profile name="wtsDelText" extends="fs25_textDefault" with="anchorTopCenter"> <size value="44px 14px"/> <textSize value="10px"/> <textBold value="true"/> <textColor value="1 0.6 0.6 1"/> <textAlignment value="center"/> </Profile>
        <Profile name="wtsDelHit"  extends="emptyPanel"       with="anchorTopCenter"> <size value="44px 16px"/> <isFocusable value="true"/> </Profile>
        <Profile name="wtsNewBg"   extends="baseReference"   with="anchorTopCenter"> <size value="130px 20px"/> <imageColor value="0.12 0.28 0.15 0.95"/> </Profile>
