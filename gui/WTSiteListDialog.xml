<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!--
    WTSiteListDialog (WT-8): the site manager. Sibling of WTListDialog: same
    structure, profiles and 8-row pagination, the site field set instead of
    wage columns (Name / Purpose / Radius or state), plus an administration
    switch for master users.
      Name    (200px): center=-270px
      Purpose (140px): center=-70px
      Radius  (150px): center=90px
      Edit     (44px): center=285px
      Del      (44px): center=333px
-->
<GUI onOpen="onOpen" onClose="wtOnClose" onCreate="onCreate">
    <GuiElement profile="newLayer" />
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />

    <GuiElement profile="dialogBg" id="dialogElement" size="880px 580px">
