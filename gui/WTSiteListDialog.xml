            <Text   profile="wtsCellState" id="r1state"   position="90px -77px" text=""/>
            <Bitmap profile="wtsBtnBg"     id="r1editbg"  position="285px -77px"/>
            <Text   profile="wtsBtnText"   id="r1edittxt" position="285px -78px" text="Edit"/>
            <Button profile="wtsBtnHit"    id="r1edit"    position="285px -77px" onClick="onClickEdit1" toolTip="Edit site"/>
            <Bitmap profile="wtsDelBg"     id="r1delbg"   position="333px -77px"/>
