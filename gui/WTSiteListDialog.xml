            <Text profile="wtsFooter" id="statusText" position="-150px -233px" text=""/>

            <Bitmap profile="wtsPageBg"   id="prevBg"   position="-385px -254px"/>
            <Text   profile="wtsPageText" id="prevText" position="-385px -256px" text="&lt; Prev"/>
            <Button profile="wtsPageHit"  id="prevBtn"  position="-385px -254px" onClick="onClickPrev"/>
